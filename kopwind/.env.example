# Optioneel: OpenRouteService API-key voor fietsroutering.
# Zonder key gebruikt de app automatisch de publieke OSRM-fietsrouter (geen key nodig).
# Gratis key aanvragen: https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Publieke site-URL voor SEO (canonical, Open Graph, robots.txt, sitemap.xml).
# Op Vercel: zet dit op het live domein. Zonder waarde valt de code terug
# op https://kanhetvandaag.nl (zie lib/site.js), maar expliciet is beter.
NEXT_PUBLIC_SITE_URL=https://kanhetvandaag.nl

# --- Analytics en Search Console (SEO-basis) ---

# Google Analytics 4 meet-ID (Beheer > Gegevensstromen > je webstream).
# Zonder waarde laadt GA niet en meet je niets (handig lokaal).
NEXT_PUBLIC_GA_ID=G-DRGGM053ZK

# Search Console-verificatie via meta-tag: alleen het token, zonder het
# "google-site-verification=" deel. Zonder waarde valt de code terug op
# het aangeleverde token (zie app/layout.js).
NEXT_PUBLIC_GSC_VERIFICATION=tEQzAKIovrtdIlkGo9YjpCFk_OVG2Qo4yPcAVIQ9IPc

# --- Synchronisatie en meldingen (allemaal gratis aan te maken) ---

# Supabase project (free tier): Settings > API. Service-role key ALLEEN
# server-side gebruiken, nooit met NEXT_PUBLIC_ prefix.
# Eenmalig: plak supabase/schema.sql in de Supabase SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# VAPID-sleutels voor webpush. Eenmalig genereren:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jij@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Geheim voor de meldingen-cron. Stel bij cron-job.org (gratis) een job in:
# elke 5 minuten GET https://jouwdomein.nl/api/cron/meldingen
# met header  x-cron-secret: <zelfde waarde als hieronder>
CRON_SECRET=
